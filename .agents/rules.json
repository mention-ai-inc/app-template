{
  "aggregate-state-vs-status": [
    "control-plane/control_plane/domain/**/*.py",
    "library/library/domain/**/*.py",
    "services/*/*/domain/**/*.py"
  ],
  "application-layer-dependencies": [
    "services/*/*/application/**/*.py",
    "services/*/tests/application/**/*.py"
  ],
  "library-dependency-sync": [
    "control-plane/**/*.py",
    "library/**",
    "services/**"
  ],
  "logging": [
    "admin/**/*.py",
    "services/**/*.py"
  ],
  "no-comments": [],
  "no-schema-defaults": [
    "backfills/backfills/**/*.py",
    "control-plane/control_plane/domain/**/*.py",
    "library/library/domain/**/*.py",
    "services/*/*/domain/**/*.py"
  ],
  "prd-structure": [
    "docs/product/prds/**"
  ],
  "product-design": [
    "apps/web/**",
    "apps/mobile/**"
  ],
  "python-class-methods": [
    "**/*.py"
  ],
  "python-imports": [
    "**/*.py"
  ],
  "python-loop-iteration": [
    "**/*.py"
  ],
  "python-unused-arguments": [
    "**/*.py"
  ],
  "react-components-and-data": [
    "**/*.tsx"
  ],
  "read-after-write": [
    "control-plane/control_plane/providers/**/*.py",
    "services/*/*/application/**/*.py",
    "services/*/tests/application/**/*.py"
  ],
  "service-communication": [],
  "typescript-imports-and-types": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "value-object-str-wraps": [
    "**/*.py"
  ]
}
