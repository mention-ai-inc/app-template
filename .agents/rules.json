{
  "aggregate-state-vs-status": [
    "control-plane/control_plane/domain/**/*.py",
    "library/library/domain/**/*.py",
    "services/*/*/domain/**/*.py"
  ],
  "application-layer-dependencies": [
    "services/*/*/application/**/*.py",
    "services/*/tests/application/**/*.py"
  ],
  "glossary": [
    "docs/product/glossary.md",
    "docs/product/prds/**",
    "library/library/domain/**/*.py",
    "services/*/*/domain/**/*.py"
  ],
  "id-field-names": [
    "**/*.py"
  ],
  "layer-responsibilities": [
    "control-plane/control_plane/**/*.py",
    "library/library/**/*.py",
    "services/*/*/**/*.py"
  ],
  "library-dependency-sync": [
    "control-plane/**/*.py",
    "library/**",
    "services/**"
  ],
  "logging": [
    "admin/**/*.py",
    "services/**/*.py"
  ],
  "no-comments": [],
  "no-schema-defaults": [
    "backfills/backfills/**/*.py",
    "control-plane/control_plane/domain/**/*.py",
    "library/library/domain/**/*.py",
    "services/*/*/domain/**/*.py"
  ],
  "prd-structure": [
    "docs/product/prds/**"
  ],
  "product-design": [
    "apps/web/**",
    "apps/mobile/**"
  ],
  "python-class-methods": [
    "**/*.py"
  ],
  "python-imports": [
    "**/*.py"
  ],
  "python-loop-iteration": [
    "**/*.py"
  ],
  "python-unused-arguments": [
    "**/*.py"
  ],
  "query-indexes": [
    "services/*/*/infrastructure/**/*.py"
  ],
  "react-components-and-data": [
    "**/*.tsx"
  ],
  "read-after-write": [
    "control-plane/control_plane/providers/**/*.py",
    "services/*/*/application/**/*.py",
    "services/*/tests/application/**/*.py"
  ],
  "read-models": [
    "apps/mcp/src/**",
    "apps/mobile/**",
    "apps/web/src/**",
    "packages/acme-api-client/src/**",
    "services/*/*/application/**/dtos.py",
    "services/*/*/infrastructure/queries/**/*.py",
    "services/*/*/presentation/servers/rest/routers/**/*.py"
  ],
  "service-communication": [],
  "typescript-imports-and-types": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "ui-copy": [
    "apps/mobile/**",
    "apps/web/**"
  ],
  "unit-of-work-scope": [
    "services/*/*/application/**/*.py",
    "services/*/tests/application/**/*.py"
  ],
  "value-object-str-wraps": [
    "**/*.py"
  ],
  "web-verify-locally": [
    "apps/web/**"
  ]
}
