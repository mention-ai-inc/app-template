{
  "components": {
    "schemas": {
      "CreateNoteRequest": {
        "properties": {
          "body": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "body",
          "title"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ListNotesResponse": {
        "properties": {
          "notes": {
            "items": {
              "$ref": "#/components/schemas/NoteRead"
            },
            "type": "array"
          }
        },
        "required": [
          "notes"
        ],
        "type": "object"
      },
      "NoteRead": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/NoteStatus"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "created_at",
          "id",
          "status",
          "summary",
          "title"
        ],
        "type": "object"
      },
      "NoteStatus": {
        "enum": [
          "pending",
          "summarizing",
          "summarized"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Combined API specification for all services",
    "title": "Unified API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/rest/notes/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "Health"
        ]
      }
    },
    "/rest/notes/notes": {
      "get": {
        "operationId": "list_notes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListNotesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List notes",
        "tags": [
          "Notes"
        ]
      },
      "post": {
        "operationId": "create_note",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create a note",
        "tags": [
          "Notes"
        ]
      }
    }
  }
}
