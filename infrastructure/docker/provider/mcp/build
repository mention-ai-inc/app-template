#!/bin/bash
set -e

TAG=$1

BUILDER=${DOCKER_BUILDER:-acme}
docker buildx inspect "$BUILDER" >/dev/null 2>&1 || docker buildx create --name "$BUILDER" --driver docker-container >/dev/null

docker buildx build \
    --builder "$BUILDER" \
    --platform linux/amd64 \
    --push \
    -t "$TAG" \
    -f infrastructure/docker/mcp/Dockerfile \
    --build-arg FEATURE_ENVIRONMENT="$FEATURE_ENVIRONMENT" \
    .
