#!/bin/bash
set -e

unset VIRTUAL_ENV

uv sync --all-extras
pnpm install

uv --project control-plane sync --all-extras
uv --project admin sync --all-extras

infrastructure/cli/env-setup/install-cloud-providers admin
uv run python infrastructure/cli/_helpers/pyright_config.py

if [ -x infrastructure/cli/language/init ]; then
  infrastructure/cli/language/init
fi
