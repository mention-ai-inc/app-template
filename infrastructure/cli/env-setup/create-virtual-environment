#!/bin/bash
set -e

unset VIRTUAL_ENV

ROOT_DIR=$(pwd)
LANGUAGE_HOOK="$ROOT_DIR/infrastructure/cli/language/create-virtual-environment"

sync_target() {
    cd "$ROOT_DIR/$1"
    uv sync --all-extras
    cd "$ROOT_DIR"
}

main() {
    case "$1" in
        main)
            uv sync --all-extras
            "$ROOT_DIR/infrastructure/cli/env-setup/install-cloud-providers"
            ;;
        control-plane)
            sync_target control-plane
            "$ROOT_DIR/infrastructure/cli/env-setup/install-cloud-providers"
            ;;
        admin)
            sync_target admin
            "$ROOT_DIR/infrastructure/cli/env-setup/install-cloud-providers" admin
            ;;
        *)
            if [ -x "$LANGUAGE_HOOK" ]; then
                "$LANGUAGE_HOOK" "$@"
            else
                echo "Error: no backend language installed, cannot create an environment for '$1'"
                exit 1
            fi
            ;;
    esac
}

main "$@"
