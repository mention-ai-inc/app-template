#!/bin/bash
set -e

# disable the virtual environment so that the correct environment is used for the targeted directory
unset VIRTUAL_ENV

ROOT_DIR=$(pwd)

main() {
    if [ $1 = "main" ]; then
        uv sync --all-extras
        "$ROOT_DIR/infrastructure/cli/env-setup/install-cloud-providers"
    else
        if [ "$1" = "control-plane" ]; then
            TARGET=control-plane
        elif [ "$1" = "library" ]; then
            TARGET=library
        elif [ "$1" = "admin" ]; then
            TARGET=admin
        elif [ "$1" = "backfills" ]; then
            TARGET=backfills
        else
            NAME=$(echo $1 | awk -F'-' '{print $1}')
            if [ -d "services/$NAME" ]; then
                TARGET=services/$NAME
            else
                echo "Error: Service '$NAME' not found in services/"
                exit 1
            fi
        fi

        cd "$ROOT_DIR/$TARGET"
        uv sync --all-extras
        cd "$ROOT_DIR"

        if [ "$TARGET" = "control-plane" ] || [ "$TARGET" = "library" ]; then
            "$ROOT_DIR/infrastructure/cli/env-setup/install-cloud-providers"
        else
            "$ROOT_DIR/infrastructure/cli/env-setup/install-cloud-providers" "$TARGET"
        fi
    fi
}

main $*
