#!/bin/bash

SKIP_CLERK="${SKIP_CLERK:-false}"

for arg in "$@"; do
    case $arg in
        --skip-clerk)
            SKIP_CLERK=true
            ;;
        *)
            echo "Unknown argument: $arg"
            echo "Usage: run-clear-feature-environment [--skip-clerk]"
            exit 1
            ;;
    esac
done

if [ "$SKIP_CLERK" = "1" ] || [ "$SKIP_CLERK" = "true" ]; then
    echo "Skipping clerk stage"
else
    infrastructure/cli/deployment/clear-feature-environment/clerk
fi

infrastructure/cli/deployment/clear-feature-environment/database
infrastructure/cli/deployment/clear-feature-environment/cache
infrastructure/cli/deployment/clear-feature-environment/tasks
infrastructure/cli/deployment/clear-feature-environment/storage
