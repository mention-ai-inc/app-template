#!/bin/bash
set -eo pipefail

PACKAGE_DIR=packages/acme-api
OUTPUT_DIR=${API_CONTRACT_OUTPUT:-$PACKAGE_DIR}
GENERATOR=infrastructure/cli/language/generate-openapi
CANONICALIZER=infrastructure/cli/_helpers/canonicalize_openapi.py
SPECIFICATION=$OUTPUT_DIR/openapi.json
CLIENT=$OUTPUT_DIR/src/api.d.ts

mkdir -p "$OUTPUT_DIR/src"

if [ -x "$GENERATOR" ]; then
    echo "Generating OpenAPI specification for API..."
    "$GENERATOR" | python3 "$CANONICALIZER" --output "$SPECIFICATION"
    echo "OpenAPI specification for API generated successfully."
elif [ -f "$PACKAGE_DIR/openapi.json" ]; then
    echo "No backend language installed: compiling the committed $PACKAGE_DIR/openapi.json."
    if [ "$SPECIFICATION" != "$PACKAGE_DIR/openapi.json" ]; then
        cp "$PACKAGE_DIR/openapi.json" "$SPECIFICATION"
    fi
else
    echo "No backend language installed and no committed $PACKAGE_DIR/openapi.json, so there is no API to compile."
    exit 1
fi

echo "Generating client for API..."
pnpx openapi-typescript "$SPECIFICATION" -o "$CLIENT"
echo "Client for API generated successfully."
