FEATURE_ENVIRONMENT="${FEATURE_ENVIRONMENT-$(git rev-parse --abbrev-ref HEAD)}"
export FEATURE_ENVIRONMENT=$(echo $FEATURE_ENVIRONMENT | sed 's/-//g')

if [ "$FEATURE_ENVIRONMENT" = "main" ]
then
    export FEATURE_ENVIRONMENT=
fi
export VITE_FEATURE_ENVIRONMENT=$FEATURE_ENVIRONMENT

if [ -f infrastructure/cli/provider/feature-environment ]; then
    source infrastructure/cli/provider/feature-environment
fi
