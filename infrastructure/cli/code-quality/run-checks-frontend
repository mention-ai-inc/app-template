#!/bin/bash

install_frontend_environment() {
    pnpm install
    if [ $? -ne 0 ]; then
        echo "pnpm install failed."
        exit 1
    fi
}

run_app_typecheck() {
    local app=$1
    echo "Type checking $app..."
    pnpm run type-check
    if [ $? -ne 0 ]; then
        echo "Type checking $app failed."
        exit 1
    fi
}

run_app_format_check() {
    local app=$1
    echo "Format checking $app..."
    pnpm run format-check
    if [ $? -ne 0 ]; then
        echo "Formatting $app failed."
        exit 1
    fi
}

run_app_lint() {
    local app=$1
    echo "Linting $app..."
    pnpm run lint
    if [ $? -ne 0 ]; then
        echo "Linting $app failed."
        exit 1
    fi
}

run_app_checks() {
    echo "Running app checks..."
    local repo_root
    repo_root=$(pwd)
    for app in apps/web apps/mcp apps/mobile; do
        cd "$repo_root/$app" || exit 1
        run_app_typecheck "$app"
        run_app_format_check "$app"
        run_app_lint "$app"
    done
    cd "$repo_root" || exit 1
    echo "App checks passed!"
}

run_mcp_tests() {
    echo "Testing @acme/mcp..."
    pnpm --filter @acme/mcp test
    if [ $? -ne 0 ]; then
        echo "Tests for @acme/mcp failed."
        exit 1
    fi
}

main() {
    echo "Preparing frontend environment..."
    install_frontend_environment
    run_mcp_tests
    run_app_checks
}

main

