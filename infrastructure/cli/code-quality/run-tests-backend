#!/bin/bash

unset VIRTUAL_ENV
CHANGED=$(.venv/bin/python infrastructure/cli/_helpers/get_changed.py --compare-to=main --include-uncommitted)

TESTS_FAILED=0

run_tests() {
    CURRENT_DIR=$(pwd)
    cd $1
    export SERVICE=$(basename $1)
    uv run pytest
    if [ $? -ne 0 ]
    then
        TESTS_FAILED=1
    fi
    cd $CURRENT_DIR
}

echo "Running tests for control-plane..."
if [ "$(echo $CHANGED | jq -r '.control_plane')" = "true" ]
then
    if [ ! -d control-plane/.venv ]
    then
        infrastructure/cli/env-setup/create-virtual-environment control-plane
    fi
    run_tests control-plane
else
    echo "No control-plane changes detected, skipping tests."
fi

echo "Running tests for library..."
if [ "$(echo $CHANGED | jq -r '.library')" = "true" ]
then
    if [ ! -d library/.venv ]
    then
        infrastructure/cli/env-setup/create-virtual-environment library
    fi
    run_tests library
else
    echo "No library changes detected, skipping tests."
fi

echo "Running tests for cloud providers..."
for manifest in control-plane/providers/*/pyproject.toml
do
    [ -e "$manifest" ] || continue
    run_tests $(dirname "$manifest")
done

echo "Running tests for services with changes..."
for service in $(echo $CHANGED | jq -r '.services[]')
do
    if [ ! -d services/$service ]; then
        echo "Service $service no longer exists, skipping tests."
        continue
    fi

    echo "Running tests for $service..."
    if [ ! -d services/$service/.venv ]
    then
        infrastructure/cli/env-setup/create-virtual-environment $service
    fi
    run_tests services/$service
    SERVICE_TESTED=1
done

echo "Running tests for backfills..."
if [ -f backfills/pyproject.toml ] && [ "$(echo $CHANGED | jq -r '.backfills')" = "true" ]
then
    if [ ! -d backfills/.venv ]
    then
        infrastructure/cli/env-setup/create-virtual-environment backfills
    fi
    run_tests backfills
    BACKFILLS_TESTED=1
else
    echo "No backfills changes detected, skipping tests."
fi

echo "Running tests for admin..."
if [ "$(echo $CHANGED | jq -r '.admin')" = "true" ]
then
    if [ ! -d admin/.venv ]
    then
        infrastructure/cli/env-setup/create-virtual-environment admin
    fi
    run_tests admin
    ADMIN_TESTED=1
else
    echo "No admin changes detected, skipping tests."
fi

if [ -z "$SERVICE_TESTED" ] && [ -z "$ADMIN_TESTED" ] && [ -z "$BACKFILLS_TESTED" ]
then
    echo "No services with changes detected, skipping tests."
fi

if [ $TESTS_FAILED -eq 1 ]
then
    echo "Some tests failed!"
    exit 1
else
    echo "All tests passed!"
fi
