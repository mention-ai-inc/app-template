#!/bin/bash

unset VIRTUAL_ENV
CHANGED=$(.venv/bin/python infrastructure/cli/_helpers/get_changed.py --compare-to=main --include-uncommitted)
export CHANGED

TESTS_FAILED=0

changed() {
    [ "$(echo "$CHANGED" | jq -r ".$1")" = "true" ]
}

run_tests() {
    CURRENT_DIR=$(pwd)
    cd "$1"
    export SERVICE=$(basename "$1")
    uv run pytest
    if [ $? -ne 0 ]
    then
        TESTS_FAILED=1
    fi
    cd "$CURRENT_DIR"
}

echo "Running tests for control-plane..."
if changed control_plane
then
    if [ ! -d control-plane/.venv ]
    then
        infrastructure/cli/env-setup/create-virtual-environment control-plane
    fi
    run_tests control-plane
else
    echo "No control-plane changes detected, skipping tests."
fi

echo "Running tests for cloud providers..."
for manifest in control-plane/providers/*/pyproject.toml
do
    [ -e "$manifest" ] || continue
    run_tests "$(dirname "$manifest")"
done

echo "Running tests for admin..."
if changed admin || changed control_plane
then
    if [ ! -d admin/.venv ]
    then
        infrastructure/cli/env-setup/create-virtual-environment admin
    fi
    run_tests admin
else
    echo "No admin changes detected, skipping tests."
fi

if [ -x infrastructure/cli/language/run-tests-backend ]
then
    infrastructure/cli/language/run-tests-backend
    if [ $? -ne 0 ]
    then
        TESTS_FAILED=1
    fi
else
    echo "No backend language installed, skipping library, service and backfill tests."
fi

if [ $TESTS_FAILED -eq 1 ]
then
    echo "Some tests failed!"
    exit 1
else
    echo "All tests passed!"
fi
