PATH_add $PWD/.venv/google-cloud-sdk/bin

PROVIDER_REQUIRED_PACKAGES=(gcloud)

# copy ADC to inside repo. Why? Because when using the default location of ADC, all GCP SDKs will
# invoke gcloud through a subprocess in order to determine the project ID, even if it is already
# set in the environment. I have no idea why on earth this is the policy. This is a workaround for
# that: if the ADC are in a non-standard location, we skip loading the project ID via the CLI, and
# it instead looks to the GOOGLE_CLOUD_PROJECT environment variable.
[ -e .adc.json ] || ln -s $HOME/.config/gcloud/application_default_credentials.json .adc.json
export GOOGLE_APPLICATION_CREDENTIALS=$PWD/.adc.json
export GOOGLE_CLOUD_PROJECT=acme-feature-0000
