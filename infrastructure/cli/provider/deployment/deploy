#!/bin/bash
set -e
source infrastructure/cli/_helpers/load-project-settings

source infrastructure/cli/_helpers/set-feature-environment
source infrastructure/cli/provider/helpers/get-feature-instance-ip

if [ -z "$CI" ]
then
    if [ "$FEATURE_ENVIRONMENT" = "" ]
    then
        echo "Cannot deploy to production environment from local"
        exit 1
    fi
else
    CI_FLAGS="--quiet"
fi

build_image() {
    SERVICE_NAME=$1

    echo "Building Docker image for $SERVICE_NAME..."
    source infrastructure/cli/provider/deployment/build-service $SERVICE_NAME
}

load_deployable_components() {
    if [ -n "$DEPLOYABLE_COMPONENTS" ]; then
        return
    fi

    pushd infrastructure/terraform/configurations/services >/dev/null
    if [ ! -d ".terraform" ]; then
        terraform init >/dev/null
    fi
    DEPLOYABLE_COMPONENTS=$(TF_WORKSPACE="${FEATURE_ENVIRONMENT:-default}" terraform output -json deployable_components 2>/dev/null) || true
    popd >/dev/null

    if [ -z "$DEPLOYABLE_COMPONENTS" ]; then
        echo "Deployment failed: terraform has published no components for '${FEATURE_ENVIRONMENT:-production}'. Run 'm terraform-services' first." >&2
        return 1
    fi
}

component_field() {
    COMPONENT_KEY=$1
    FIELD=$2

    VALUE=$(jq -r --arg key "$COMPONENT_KEY" --arg field "$FIELD" '.[$key][$field] // empty' <<< "$DEPLOYABLE_COMPONENTS")
    if [ -z "$VALUE" ]; then
        echo "Deployment failed: terraform has no $FIELD for $COMPONENT_KEY. Run 'm terraform-services' first." >&2
        return 1
    fi
    echo "$VALUE"
}

service_image_uri() {
    echo "us-central1-docker.pkg.dev/${GOOGLE_CLOUD_PROJECT}/${FEATURE_ENVIRONMENT}services/$1:main"
}

deploy_component() {
    SERVICE_NAME=$1
    COMPONENT_KEY=$2

    CLOUD_RUN_NAME=$(component_field "$COMPONENT_KEY" cloud_run_name) || { FAILED=1; return 1; }
    COMPONENT_COMMAND=$(component_field "$COMPONENT_KEY" command) || { FAILED=1; return 1; }
    COMPONENT_KIND=$(component_field "$COMPONENT_KEY" kind) || { FAILED=1; return 1; }
    IMAGE_URI=$(service_image_uri $SERVICE_NAME)

    if [ "$COMPONENT_KIND" == "job" ]; then
        gcloud run jobs update "$CLOUD_RUN_NAME" $CI_FLAGS \
            --image=$IMAGE_URI \
            --command "$COMPONENT_COMMAND" \
            --region=us-central1 \
            --project=$GOOGLE_CLOUD_PROJECT
    else
        gcloud run deploy "$CLOUD_RUN_NAME" $CI_FLAGS \
            --image=$IMAGE_URI \
            --command "$COMPONENT_COMMAND" \
            --region=us-central1 \
            --project=$GOOGLE_CLOUD_PROJECT
    fi

    if [ $? -ne 0 ]; then
        FAILED=1
    fi
}

deploy_compute_engine() {
    SERVICE_NAME=$1
    COMPONENT_TYPE=$2
    COMPONENT_NAME=$3

    MIG_NAME="${FEATURE_ENVIRONMENT}${SERVICE_NAME}-${COMPONENT_TYPE}-${COMPONENT_NAME}"
    ZONE=$(get_feature_mig_zone "${MIG_NAME}" "${GOOGLE_CLOUD_PROJECT}")
    if [ -z "$ZONE" ]; then
        echo "Could not resolve zone for managed instance group ${MIG_NAME}"
        FAILED=1
        return 1
    fi

    gcloud compute instance-groups managed rolling-action restart \
        "${MIG_NAME}" \
        --zone="${ZONE}" \
        --project=$GOOGLE_CLOUD_PROJECT
}

deploy_service() {
    SERVICE_NAME=$1

    load_deployable_components || return 1

    build_image "$SERVICE_NAME" || return 1

    # workers are deliberately absent from deployable_components: each worker pool runs a single
    # instance, so redeploying one causes downtime while it restarts. they are redeployed by hand.
    for COMPONENT_KEY in $(jq -r --arg prefix "${SERVICE_NAME}-" 'keys[] | select(startswith($prefix))' <<< "$DEPLOYABLE_COMPONENTS"); do
        echo "Deploying $COMPONENT_KEY to $FEATURE_ENVIRONMENT environment..."
        deploy_component "$SERVICE_NAME" "$COMPONENT_KEY" || return 1
    done
    wait
}

build_and_deploy_component() {
    SERVICE_NAME=$1
    COMPONENT_TYPE=$2
    COMPONENT_NAME=$3

    build_image "$SERVICE_NAME" || return 1

    if [ $COMPONENT_TYPE == "worker" ]; then
        deploy_compute_engine $SERVICE_NAME $COMPONENT_TYPE $COMPONENT_NAME
        return
    fi

    load_deployable_components || return 1
    deploy_component $SERVICE_NAME "${SERVICE_NAME}-${COMPONENT_TYPE}-${COMPONENT_NAME}"
}

build_and_deploy_service() {
    FAILED=0
    SERVICE_NAME=$1
    deploy_service $SERVICE_NAME || return 1
}

deploy_web() {
    [ "$PROJECT_ENABLE_WEB" = true ] || { echo "Enable web in project.json first"; return 1; }
    source infrastructure/cli/provider/deployment/run-terraform -f web -o apply
}

deploy_mcp() {
    [ "$PROJECT_ENABLE_MCP" = true ] || { echo "Enable MCP in project.json first"; return 1; }
    TAG="us-central1-docker.pkg.dev/${GOOGLE_CLOUD_PROJECT}/${FEATURE_ENVIRONMENT}mcp/mcp:main"

    CLOUDSDK_BUILDS_REGION=us-central1 \
    gcloud builds submit \
        --config infrastructure/docker/provider/mcp/cloudbuild.yaml \
        --substitutions _TAG=$TAG \
        --project $GOOGLE_CLOUD_PROJECT \
        --region us-central1 \
        --service-account projects/$GOOGLE_CLOUD_PROJECT/serviceAccounts/${FEATURE_ENVIRONMENT}cloud-build@$GOOGLE_CLOUD_PROJECT.iam.gserviceaccount.com \
        --polling-interval=5 \
        .

    gcloud run deploy "${FEATURE_ENVIRONMENT}mcp-s-rest" $CI_FLAGS \
        --image=$TAG \
        --region=us-central1 \
        --project=$GOOGLE_CLOUD_PROJECT
}

main() {
    if [ $# -eq 3 ]; then
        build_and_deploy_component $@
    elif [ $# -eq 1 ]; then
        if [ $1 == "web" ]; then
            deploy_web
        elif [ $1 == "mcp" ]; then
            deploy_mcp
        else
            build_and_deploy_service $1
        fi
    elif [ $# -eq 0 ]; then
        CHANGED=$(uv run python infrastructure/cli/_helpers/get_changed.py --compare-to=${DEPLOY_COMPARE_TO:-previous})
        for service in $(ls services); do
            if [[ $(jq -r ".services[] | select(. == \"${service}\")" <<< $CHANGED) == "${service}" || $(jq -r ".library" <<< $CHANGED) == "true" ]]; then
                BUILT_SOMETHING=1
                build_and_deploy_service $service
            fi
        done
        if [[ "$PROJECT_ENABLE_WEB" == true && $(jq -r ".web" <<< $CHANGED) == "true" ]]; then
            BUILT_SOMETHING=1
            deploy_web
        fi
        if [[ "$PROJECT_ENABLE_MCP" == true && $(jq -r ".mcp" <<< $CHANGED) == "true" ]]; then
            BUILT_SOMETHING=1
            deploy_mcp
        fi
        wait
        if [ -z "$BUILT_SOMETHING" ]; then
            echo "No changes found in any services according to Git status, so not deploying any of them."
        fi
    else
        # Invalid number of arguments
        echo "Invalid number of arguments. Use either:"
        echo "  deploy <service_name> <component_type> <component_name>   # To deploy a specific component"
        echo "  deploy <service_name>                                     # To deploy all components of a service"
        echo "  deploy web                                                # To deploy the web app"
        echo "  deploy mcp                                                # To deploy the MCP server"
        exit 1
    fi

    if [ "$FAILED" = "1" ]; then
        echo "Deployment failed."
        exit 1
    fi
}

main $@
