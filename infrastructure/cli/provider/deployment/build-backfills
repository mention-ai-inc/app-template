#!/bin/bash
set -e

source infrastructure/cli/_helpers/set-feature-environment
source infrastructure/cli/provider/helpers/ecr-login

ecr_login

TAG="${ECR_REGISTRY}/${FEATURE_ENVIRONMENT}admin:backfills-main"
CACHE_TAG="${ECR_REGISTRY}/docker-cache:backfills-main"

echo "Building the backfills image for the ${FEATURE_ENVIRONMENT:-production} environment..."

infrastructure/docker/provider/backfills/build "$TAG" "$CACHE_TAG"
