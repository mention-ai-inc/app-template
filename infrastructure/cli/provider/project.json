{
  "cloud": "azure",
  "fields": [
    {
      "key": "engineer_email",
      "pattern": "[A-Za-z0-9_.+-]+@[A-Za-z0-9.-]+",
      "description": "An existing engineer account, before the first apply",
      "foundation": true,
      "mappings": [
        {
          "placeholder": "engineer@acme.example.com",
          "paths": [
            "infrastructure/terraform/**",
            "infrastructure/cli/provider/**",
            "library/providers/**",
            ".agents/**",
            "docs/**"
          ]
        }
      ]
    },
    {
      "key": "vercel_team_id",
      "pattern": "team_[A-Za-z0-9]+",
      "description": "Vercel team id",
      "foundation": false,
      "mappings": [
        {
          "placeholder": "team_0000000000000000",
          "paths": [
            "infrastructure/terraform/**",
            "infrastructure/cli/provider/**",
            "library/providers/**",
            ".agents/**",
            "docs/**"
          ]
        }
      ]
    },
    {
      "key": "subscription_id",
      "pattern": "[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}",
      "description": "Azure subscription id",
      "foundation": true,
      "mappings": [
        {
          "placeholder": "00000000-0000-0000-0000-000000000000",
          "paths": [
            "infrastructure/terraform/**",
            "infrastructure/cli/provider/**",
            "library/providers/**",
            ".agents/**",
            "docs/**"
          ],
          "selector": "(?i)subscription_id"
        }
      ]
    },
    {
      "key": "tenant_id",
      "pattern": "[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}",
      "description": "Azure tenant id",
      "foundation": true,
      "mappings": [
        {
          "placeholder": "00000000-0000-0000-0000-000000000000",
          "paths": [
            "infrastructure/terraform/**",
            "infrastructure/cli/provider/**",
            "library/providers/**",
            ".agents/**",
            "docs/**"
          ],
          "selector": "(?i)tenant_id"
        }
      ]
    },
    {
      "key": "engineer_object_id",
      "pattern": "[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}",
      "description": "Engineer directory object id",
      "foundation": true,
      "mappings": [
        {
          "placeholder": "00000000-0000-0000-0000-000000000000",
          "paths": [
            "infrastructure/terraform/modules/permissions/main.tf"
          ]
        }
      ]
    },
    {
      "key": "operations_name",
      "pattern": "[a-z][a-z0-9-]{2,17}",
      "description": "Globally unique operations resource name prefix",
      "foundation": true,
      "mappings": [
        {
          "placeholder": "acme-operations-0000",
          "paths": [
            "infrastructure/terraform/**",
            "infrastructure/cli/provider/**",
            "library/providers/**",
            ".agents/**",
            "docs/**"
          ]
        }
      ]
    },
    {
      "key": "operations_compact_name",
      "pattern": "[a-z][a-z0-9]{2,20}",
      "description": "Globally unique alphanumeric operations storage prefix",
      "foundation": true,
      "mappings": [
        {
          "placeholder": "acmeoperations0000",
          "paths": [
            "infrastructure/terraform/**",
            "infrastructure/cli/provider/**",
            "library/providers/**",
            ".agents/**",
            "docs/**"
          ]
        }
      ]
    },
    {
      "key": "production_name",
      "pattern": "[a-z][a-z0-9-]{2,17}",
      "description": "Globally unique production resource name prefix",
      "foundation": true,
      "mappings": [
        {
          "placeholder": "acme-production-0000",
          "paths": [
            "infrastructure/terraform/**",
            "infrastructure/cli/provider/**",
            "library/providers/**",
            ".agents/**",
            "docs/**"
          ]
        }
      ]
    },
    {
      "key": "production_compact_name",
      "pattern": "[a-z][a-z0-9]{2,20}",
      "description": "Globally unique alphanumeric production storage prefix",
      "foundation": true,
      "mappings": [
        {
          "placeholder": "acmeproduction0000",
          "paths": [
            "infrastructure/terraform/**",
            "infrastructure/cli/provider/**",
            "library/providers/**",
            ".agents/**",
            "docs/**"
          ]
        }
      ]
    },
    {
      "key": "feature_name",
      "pattern": "[a-z][a-z0-9-]{2,17}",
      "description": "Globally unique feature resource name prefix",
      "foundation": true,
      "mappings": [
        {
          "placeholder": "acme-feature-0000",
          "paths": [
            "infrastructure/terraform/**",
            "infrastructure/cli/provider/**",
            "library/providers/**",
            ".agents/**",
            "docs/**"
          ]
        }
      ]
    },
    {
      "key": "feature_compact_name",
      "pattern": "[a-z][a-z0-9]{2,20}",
      "description": "Globally unique alphanumeric feature storage prefix",
      "foundation": true,
      "mappings": [
        {
          "placeholder": "acmefeature0000",
          "paths": [
            "infrastructure/terraform/**",
            "infrastructure/cli/provider/**",
            "library/providers/**",
            ".agents/**",
            "docs/**"
          ]
        }
      ]
    },
    {
      "key": "region",
      "pattern": "[a-z0-9]+",
      "description": "Azure region",
      "foundation": true,
      "mappings": [
        {
          "placeholder": "eastus",
          "paths": [
            "infrastructure/terraform/**",
            "infrastructure/cli/provider/**",
            "library/providers/**",
            ".agents/**",
            "docs/**"
          ]
        }
      ]
    }
  ],
  "checks": [
    {
      "name": "terraform",
      "command": [
        "terraform",
        "version"
      ],
      "requires": [],
      "remedy": "Install Terraform; see docs/bootstrap.md",
      "stage": "cloud"
    },
    {
      "name": "docker",
      "command": [
        "docker",
        "info"
      ],
      "requires": [],
      "remedy": "Start Docker",
      "stage": "cloud"
    },
    {
      "name": "buildx",
      "command": [
        "docker",
        "buildx",
        "version"
      ],
      "requires": [],
      "remedy": "Install Docker buildx",
      "stage": "cloud"
    },
    {
      "name": "jq",
      "command": [
        "jq",
        "--version"
      ],
      "requires": [],
      "remedy": "Install jq",
      "stage": "cloud"
    },
    {
      "name": "azure-account",
      "command": [
        "az",
        "account",
        "show",
        "--subscription",
        "{subscription_id}",
        "--query",
        "id",
        "--output",
        "tsv"
      ],
      "requires": [
        "subscription_id"
      ],
      "remedy": "Sign in to the configured subscription",
      "stage": "cloud"
    },
    {
      "name": "terraform-state",
      "command": [
        "az",
        "storage",
        "container",
        "show",
        "--account-name",
        "{operations_compact_name}tf",
        "--name",
        "terraform-state",
        "--auth-mode",
        "login",
        "--query",
        "name",
        "--output",
        "tsv"
      ],
      "requires": [
        "operations_compact_name"
      ],
      "remedy": "Create the state storage account and container; grant Blob Data Contributor",
      "stage": "cloud"
    },
    {
      "name": "containerapp-extension",
      "command": [
        "az",
        "extension",
        "show",
        "--name",
        "containerapp",
        "--query",
        "name",
        "--output",
        "tsv"
      ],
      "requires": [],
      "remedy": "Install the containerapp extension as described in the guide",
      "stage": "cloud"
    },
    {
      "name": "CLERK-SECRET-KEY",
      "command": [
        "az",
        "keyvault",
        "secret",
        "list-versions",
        "--vault-name",
        "{feature_name}-kv",
        "--name",
        "CLERK-SECRET-KEY",
        "--query",
        "[0].id",
        "--output",
        "tsv"
      ],
      "requires": [
        "feature_name"
      ],
      "remedy": "Create the required secret in the feature vault",
      "stage": "demo",
      "nonempty": true
    },
    {
      "name": "GEMINI-API-KEY",
      "command": [
        "az",
        "keyvault",
        "secret",
        "list-versions",
        "--vault-name",
        "{feature_name}-kv",
        "--name",
        "GEMINI-API-KEY",
        "--query",
        "[0].id",
        "--output",
        "tsv"
      ],
      "requires": [
        "feature_name"
      ],
      "remedy": "Create the required secret in the feature vault",
      "stage": "demo",
      "nonempty": true
    },
    {
      "name": "SENTRY_DSN",
      "stage": "demo",
      "integration": "sentry",
      "command": [
        "az",
        "keyvault",
        "secret",
        "list-versions",
        "--vault-name",
        "{operations_name}-kv",
        "--name",
        "SENTRY-DSN",
        "--query",
        "[0].id",
        "--output",
        "tsv"
      ],
      "requires": [
        "operations_name"
      ],
      "nonempty": true,
      "remedy": "Create the secret required by enabled sentry; no secret value is printed"
    },
    {
      "name": "LOGFIRE_WRITE_TOKEN",
      "stage": "demo",
      "integration": "logfire",
      "command": [
        "az",
        "keyvault",
        "secret",
        "list-versions",
        "--vault-name",
        "{feature_name}-kv",
        "--name",
        "LOGFIRE-WRITE-TOKEN",
        "--query",
        "[0].id",
        "--output",
        "tsv"
      ],
      "requires": [
        "feature_name"
      ],
      "nonempty": true,
      "remedy": "Create the secret required by enabled logfire; no secret value is printed"
    }
  ]
}
