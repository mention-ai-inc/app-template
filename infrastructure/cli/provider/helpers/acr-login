#!/bin/bash

TOKEN_LOGIN_USERNAME=00000000-0000-0000-0000-000000000000

acr_login() {
    local registry_name=${1:-$CONTAINER_REGISTRY_NAME}
    local token

    if [ -z "$registry_name" ]; then
        echo "Cannot log in to the container registry: CONTAINER_REGISTRY_NAME is not set. Source infrastructure/cli/_helpers/set-feature-environment first." >&2
        return 1
    fi

    if [ "${ACR_LOGGED_IN:-}" = "$registry_name" ]; then
        return 0
    fi

    if ! az acr login --name "$registry_name" >/dev/null 2>&1; then
        token=$(az acr login --name "$registry_name" --expose-token --output tsv --query accessToken) || return 1
        echo "$token" | docker login "${registry_name}.azurecr.io" --username "$TOKEN_LOGIN_USERNAME" --password-stdin >/dev/null || return 1
    fi

    export ACR_LOGGED_IN=$registry_name
}
