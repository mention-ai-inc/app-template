#!/bin/bash

__load_secret() {
  local env_name=$1
  local secret_id=$2

  if [ -n "${!env_name:-}" ]; then
    return
  fi

  export "${env_name}=$(aws secretsmanager get-secret-value \
    --secret-id "${secret_id}" \
    --region "${AWS_REGION}" \
    --query SecretString \
    --output text)"
  echo "Loaded ${env_name} from Secrets Manager"
}

__load_secret REDIS_PASSWORD REDIS_PASSWORD
__load_secret SENTRY_DSN SENTRY_DSN
__load_secret CLERK_SECRET_KEY CLERK_SECRET_KEY
__load_secret CLERK_WEBHOOK_SECRET CLERK_WEBHOOK_SECRET
__load_secret GEMINI_API_KEY GEMINI_API_KEY
__load_secret LOGFIRE_WRITE_TOKEN LOGFIRE_WRITE_TOKEN
