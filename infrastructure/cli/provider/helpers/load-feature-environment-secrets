#!/bin/bash

__secret_name() {
    local base=$1

    if [ -z "$FEATURE_ENVIRONMENT" ]; then
        echo "$base"
    else
        echo "${FEATURE_ENVIRONMENT}-${base}"
    fi
}

__load_secret() {
    local env_name=$1
    local vault_name=$2
    local secret_name=$3

    if [ -n "${!env_name:-}" ]; then
        return
    fi

    export "${env_name}=$(az keyvault secret show \
        --vault-name "${vault_name}" \
        --name "${secret_name}" \
        --query value \
        --output tsv)"
    echo "Loaded ${env_name} from Key Vault ${vault_name}"
}

__load_environment_secrets() {
    local vault_name
    local operations_vault_name

    vault_name=$(key_vault_name) || return 1
    operations_vault_name=$(az keyvault list --resource-group "$OPERATIONS_RESOURCE_GROUP" --query '[0].name' --output tsv)

    __load_secret REDIS_PASSWORD "$vault_name" "$(__secret_name REDIS-PASSWORD)"
    __load_secret CLERK_SECRET_KEY "$vault_name" CLERK-SECRET-KEY
    __load_secret CLERK_WEBHOOK_SECRET "$vault_name" CLERK-WEBHOOK-SECRET
    __load_secret GEMINI_API_KEY "$vault_name" GEMINI-API-KEY
    __load_secret LOGFIRE_WRITE_TOKEN "$vault_name" LOGFIRE-WRITE-TOKEN
    __load_secret SENTRY_DSN "$operations_vault_name" SENTRY-DSN
}

__load_environment_secrets
