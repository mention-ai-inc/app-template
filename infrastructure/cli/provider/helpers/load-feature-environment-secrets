#!/bin/bash
source infrastructure/cli/_helpers/load-project-settings || return 1

__secret_name() {
    local base=$1

    if [ -z "$FEATURE_ENVIRONMENT" ]; then
        echo "$base"
    else
        echo "${FEATURE_ENVIRONMENT}-${base}"
    fi
}

__load_secret() {
    local env_name=$1
    local vault_name=$2
    local secret_name=$3

    if [ -n "${!env_name:-}" ]; then
        return
    fi

    local secret_value
  secret_value=$(az keyvault secret show \
        --vault-name "${vault_name}" \
        --name "${secret_name}" \
        --query value \
        --output tsv) || return 1
  export "${env_name}=$secret_value"
    echo "Loaded ${env_name} from Key Vault ${vault_name}"
}

__load_environment_secrets() {
    local vault_name
    local operations_vault_name

    vault_name=$(key_vault_name) || return 1
    operations_vault_name=$(az keyvault list --resource-group "$OPERATIONS_RESOURCE_GROUP" --query '[0].name' --output tsv)

    __load_secret REDIS_PASSWORD "$vault_name" "$(__secret_name REDIS-PASSWORD)" || return 1
    __load_secret CLERK_SECRET_KEY "$vault_name" CLERK-SECRET-KEY || return 1
    __load_secret GEMINI_API_KEY "$vault_name" GEMINI-API-KEY || return 1
    if [ "$PROJECT_ENABLE_LOGFIRE" = true ]; then
      __load_secret LOGFIRE_WRITE_TOKEN "$vault_name" LOGFIRE-WRITE-TOKEN || return 1
    fi
    if [ "$PROJECT_ENABLE_SENTRY" = true ]; then
      __load_secret SENTRY_DSN "$operations_vault_name" SENTRY-DSN || return 1
    fi
}

__load_environment_secrets
