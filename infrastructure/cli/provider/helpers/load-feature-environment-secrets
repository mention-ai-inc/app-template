#!/bin/bash

# Skips variables already set — locally .env wins; otherwise loads from Secret Manager.

__load_secret() {
  local env_name=$1
  local secret_id=$2
  local project=$3

  if [ -n "${!env_name:-}" ]; then
    return
  fi

  export "${env_name}=$(gcloud secrets versions access latest --secret="${secret_id}" --project="${project}")"
  echo "Loaded ${env_name} from Secret Manager (${project})"
}

__load_secret REDIS_PASSWORD REDIS_PASSWORD "${OPERATIONS_PROJECT_ID}"
__load_secret SENTRY_DSN SENTRY_DSN "${OPERATIONS_PROJECT_ID}"

__load_secret CLERK_SECRET_KEY CLERK_SECRET_KEY "${FEATURE_PROJECT_ID}"
__load_secret CLERK_WEBHOOK_SECRET CLERK_WEBHOOK_SECRET "${FEATURE_PROJECT_ID}"
__load_secret GEMINI_API_KEY GEMINI_API_KEY "${FEATURE_PROJECT_ID}"
__load_secret LOGFIRE_WRITE_TOKEN LOGFIRE_WRITE_TOKEN "${FEATURE_PROJECT_ID}"
