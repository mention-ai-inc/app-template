#!/bin/bash
source infrastructure/cli/_helpers/load-project-settings || return 1

# Skips variables already set — locally .env wins; otherwise loads from Secret Manager.

__load_secret() {
  local env_name=$1
  local secret_id=$2
  local project=$3

  if [ -n "${!env_name:-}" ]; then
    return
  fi

  local secret_value
  secret_value=$(gcloud secrets versions access latest --secret="${secret_id}" --project="${project}") || return 1
  export "${env_name}=$secret_value"
  echo "Loaded ${env_name} from Secret Manager (${project})"
}

__load_secret REDIS_PASSWORD REDIS_PASSWORD "${OPERATIONS_PROJECT_ID}" || return 1
if [ "$PROJECT_ENABLE_SENTRY" = true ]; then
  __load_secret SENTRY_DSN SENTRY_DSN "${OPERATIONS_PROJECT_ID}" || return 1
fi

__load_secret CLERK_SECRET_KEY CLERK_SECRET_KEY "${FEATURE_PROJECT_ID}" || return 1
__load_secret GEMINI_API_KEY GEMINI_API_KEY "${FEATURE_PROJECT_ID}" || return 1
if [ "$PROJECT_ENABLE_LOGFIRE" = true ]; then
  __load_secret LOGFIRE_WRITE_TOKEN LOGFIRE_WRITE_TOKEN "${FEATURE_PROJECT_ID}" || return 1
fi
