#!/bin/bash
source infrastructure/cli/_helpers/load-project-settings || return 1

__load_secret() {
  local env_name=$1
  local secret_id=$2

  if [ -n "${!env_name:-}" ]; then
    return
  fi

  local secret_value
  secret_value=$(aws secretsmanager get-secret-value \
    --secret-id "${secret_id}" \
    --region "${AWS_REGION}" \
    --query SecretString \
    --output text) || return 1
  export "${env_name}=$secret_value"
  echo "Loaded ${env_name} from Secrets Manager"
}

__load_secret REDIS_PASSWORD REDIS_PASSWORD || return 1
if [ "$PROJECT_ENABLE_SENTRY" = true ]; then
  __load_secret SENTRY_DSN SENTRY_DSN || return 1
fi
if [ -n "$FEATURE_ENVIRONMENT" ]; then
  __load_secret CLERK_SECRET_KEY feature/CLERK_SECRET_KEY || return 1
else
  __load_secret CLERK_SECRET_KEY production/CLERK_SECRET_KEY || return 1
fi
__load_secret GEMINI_API_KEY GEMINI_API_KEY || return 1
if [ "$PROJECT_ENABLE_LOGFIRE" = true ]; then
  __load_secret LOGFIRE_WRITE_TOKEN LOGFIRE_WRITE_TOKEN || return 1
fi
