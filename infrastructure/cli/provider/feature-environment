export AZURE_REGION="${AZURE_REGION:-eastus}"
export AZURE_SUBSCRIPTION_ID="${AZURE_SUBSCRIPTION_ID:-${SUBSCRIPTION_ID:-00000000-0000-0000-0000-000000000000}}"
export AZURE_TENANT_ID="${AZURE_TENANT_ID:-${TENANT_ID:-00000000-0000-0000-0000-000000000000}}"
export ARM_SUBSCRIPTION_ID="$AZURE_SUBSCRIPTION_ID"
export ARM_TENANT_ID="$AZURE_TENANT_ID"

if [ "$FEATURE_ENVIRONMENT" = "" ]; then
    export AZURE_RESOURCE_GROUP="${PRODUCTION_RESOURCE_GROUP:-acme-production-0000}"
    export DEPLOY_ENVIRONMENT=production
else
    export AZURE_RESOURCE_GROUP="${FEATURE_RESOURCE_GROUP:-acme-feature-0000}"
    export DEPLOY_ENVIRONMENT="$FEATURE_ENVIRONMENT"
fi

export OPERATIONS_RESOURCE_GROUP="${OPERATIONS_RESOURCE_GROUP:-acme-operations-0000}"
export CONTAINER_REGISTRY_NAME="${CONTAINER_REGISTRY_NAME:-acmeoperations0000}"
export CONTAINER_REGISTRY="${CONTAINER_REGISTRY_NAME}.azurecr.io"
export CLOUD_PROVIDER=azure
