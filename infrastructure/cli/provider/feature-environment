export AWS_REGION="${AWS_REGION:-us-east-1}"
export AWS_DEFAULT_REGION="$AWS_REGION"

if [ "$FEATURE_ENVIRONMENT" = "" ]; then
    export AWS_ACCOUNT_ID="${AWS_ACCOUNT_ID:-${PRODUCTION_ACCOUNT_ID:-000000000000}}"
    export DEPLOY_ENVIRONMENT=production
else
    export AWS_ACCOUNT_ID="${AWS_ACCOUNT_ID:-${FEATURE_ACCOUNT_ID:-000000000000}}"
    export DEPLOY_ENVIRONMENT="$FEATURE_ENVIRONMENT"
fi

export ECR_REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
export ECS_CLUSTER_NAME="${ECS_CLUSTER_NAME:-acme}"
